#!/data/data/com.termux/files/usr/bin/bash
# ZetBot AI command-line shortcut.
# Installed by install.sh into $PREFIX/bin/zetbot.

set -u

BOT_DIR="$HOME/zetbot-ai"

if [ ! -d "$BOT_DIR" ]; then
    echo "ZetBot directory not found: $BOT_DIR"
    echo "Run the ZetBot installer first."
    exit 1
fi

cd "$BOT_DIR" || exit 1

is_termux() {
    [[ "${PREFIX:-}" == *"/com.termux"* ]] && return 0
    [[ -d /data/data/com.termux ]] && return 0
    return 1
}

usage() {
    cat <<'USAGE'
ZetBot AI CLI

Usage:
  zetbot start      Start ZetBot AI
  zetbot stop       Stop ZetBot AI
  zetbot restart    Restart ZetBot AI
  zetbot status     Show ZetBot status
  zetbot logs       Show live bot logs
  zetbot help       Show this help
USAGE
}

case "${1:-help}" in
    start)
        if is_termux && [ -x scripts/termux-start.sh ]; then
            exec bash scripts/termux-start.sh
        fi
        exec bash run.sh
        ;;
    stop)
        if is_termux && [ -x scripts/termux-start.sh ]; then
            exec bash scripts/termux-start.sh --stop
        fi
        if [ -f data/zetbot.pid ]; then
            PID="$(cat data/zetbot.pid 2>/dev/null || true)"
            if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
                kill "$PID" 2>/dev/null || true
                echo "ZetBot stopped (PID $PID)"
                exit 0
            fi
            rm -f data/zetbot.pid
        fi
        echo "ZetBot is not running"
        ;;
    restart)
        if is_termux && [ -x scripts/termux-start.sh ]; then
            bash scripts/termux-start.sh --stop || true
            sleep 2
            exec bash scripts/termux-start.sh
        fi
        if [ -f data/zetbot.pid ]; then
            PID="$(cat data/zetbot.pid 2>/dev/null || true)"
            if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
                kill "$PID" 2>/dev/null || true
                sleep 2
            fi
            rm -f data/zetbot.pid
        fi
        exec bash run.sh
        ;;
    status)
        if is_termux && [ -x scripts/termux-start.sh ]; then
            exec bash scripts/termux-start.sh --status
        fi
        if [ -f data/zetbot.pid ]; then
            PID="$(cat data/zetbot.pid 2>/dev/null || true)"
            if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
                echo "ZetBot RUNNING (PID $PID)"
                exit 0
            fi
        fi
        echo "ZetBot STOPPED"
        ;;
    logs)
        LOG="data/bot-console.log"
        [ -f "$LOG" ] || LOG="logs/bot-console.log"
        [ -f "$LOG" ] || LOG="data/zetbot.log"
        if [ -f "$LOG" ]; then
            exec tail -f "$LOG"
        fi
        echo "No ZetBot log file found yet."
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $1"
        echo ""
        usage
        exit 1
        ;;
esac
