# =============================================================================
#  ZetBot AI — Environment Configuration
#
#  Copy this file to .env and fill in your credentials:
#      cp .env.example .env
#      nano .env
#
#  Every value below matches a field in scripts/app_config.py (AppConfig).
#  Anything left blank/unset falls back to the default shown here.
# =============================================================================

# ── Secrets — fill these in ─────────────────────────────────────────────────

# Exchange API credentials. Only required when PAPER_MODE=false (live
# trading). Leave blank for paper trading.
# Security: create a key with "View" + "Trade" permission ONLY — never
# enable "Withdrawal". That way even a leaked key can't move funds out.
API_KEY=
API_SECRET=

# Telegram bot credentials. Only required when TELEGRAM_ENABLED=true.
# Token from @BotFather, chat ID from @userinfobot (or your group's ID).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Twilio credentials for WhatsApp. Only required when WHATSAPP_ENABLED=true.
# SID starts with "AC" (34 chars total). Sender/allowed numbers must use
# the "whatsapp:+<countrycode><number>" format (e.g. whatsapp:+14155238886).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Comma-separated list, e.g. whatsapp:+6281234567890,whatsapp:+6289876543210
WHATSAPP_ALLOWED_NUMBERS=

# =============================================================================
#  General
# =============================================================================

# true = simulated trading, no real funds at risk (recommended default).
# false = live trading — requires API_KEY/API_SECRET above.
PAPER_MODE=true

# Exchange to trade on. Actually implemented + validated in this project:
#   binance | bybit | tokocrypto | okx | gate | kucoin | mexc | indodax
# (coinbase | kraken | huobi | bitget | phemex are accepted by setup.sh's
# check but have NO provider implementation yet — don't use those until
# a provider class exists in scripts/exchange_providers.py.)
EXCHANGE=indodax

# Candle timeframe: 1m 3m 5m 15m 30m 1h 2h 4h 6h 8h 12h 1d 3d 1w
TIMEFRAME=15m

# Quote currency for scanning/pairs, e.g. BTC/USDT. MUST be changed to
# IDR when EXCHANGE=indodax (Indodax only has BTC/IDR-style pairs, no
# USDT pairs) — leaving this as USDT with Indodax will find zero markets.
QUOTE_CURRENCY=IDR

# ── Live protective orders (SL/TP) ──
# Off by default — a live BUY fill will NOT get automatic protection
# orders unless explicitly enabled.
AUTO_PROTECT=false
DEFAULT_STOP_PCT=3.0
DEFAULT_TAKE_PROFIT_PCT=10.0
PROTECTION_RECONCILE_INTERVAL_SECONDS=8.0

# ── Hands-off / JUNK list (LIVE) ──
# IMPORTANT — read this if you already own coins on the exchange.
# When live trading is armed, the bot auto-discovers EVERY non-dust coin in
# your wallet, adopts it into its managed positions, and WILL auto-sell it on
# stop-loss / take-profit. There is no "manual vs bot" balance distinction on
# spot exchanges like Indodax — so any coin you want to KEEP (or that you
# consider junk/illiquid) MUST be listed here or the bot will trade it.
#
# Comma-separated BASE coin symbols (no slash, no quote). Add freely — this
# is your hands-off list. Example:
#   EXCLUDE_SYMBOLS=RFC,JELLYJELLY,VRA,PLPA   <- junk/dust coins you hold
#   EXCLUDE_SYMBOLS=BTC,ETH                   <- coins you keep long-term
#   EXCLUDE_SYMBOLS=BTC,ETH,RFC,JELLYJELLY    <- both
EXCLUDE_SYMBOLS=

# ── Paths ──
DATA_DIR=data
LOGS_DIR=logs

# =============================================================================
#  Account & Risk
# =============================================================================
ACCOUNT_BALANCE=300000
MAX_POSITIONS=4
MAX_RISK_PER_TRADE_PCT=2

# =============================================================================
#  Telegram (behavior)
# =============================================================================
TELEGRAM_ENABLED=true
TELEGRAM_TIMEOUT=10
TELEGRAM_RETRY=3

# =============================================================================
#  WhatsApp (via Twilio)
# =============================================================================
# false = disabled (default). true = requires the TWILIO_* / WHATSAPP_*
# secrets above (WHATSAPP_ALLOWED_NUMBERS is mandatory — the webhook is
# public and rejects any sender not on the list).
WHATSAPP_ENABLED=false

# Address/port the local webhook server binds to. Twilio needs a public
# HTTPS URL to reach it — for local testing use: ngrok http <port>, then
# set Twilio's "WHEN A MESSAGE COMES IN" to <ngrok-url>/whatsapp/webhook.
WHATSAPP_WEBHOOK_HOST=0.0.0.0
WHATSAPP_WEBHOOK_PORT=8088

# =============================================================================
#  Scanner
# =============================================================================
SCANNER_THREADS=10
SCANNER_TOP_N=50
# Volume is measured in the QUOTE_CURRENCY (Indodax = IDR, Binance = USDT).
# Indodax: IDR volume → use >= 300000000 (300 juta IDR, ~$20k/day) to skip
#          illiquid coins. Binance: USDT volume → >= 100000 (100k USDT/day).
SCANNER_MIN_VOLUME=300000000

# =============================================================================
#  Decision Engine
# =============================================================================
DECISION_TOP_N=20

# Anti-chase entry gates (see decision_engine.py). Values tuned for the
# 15m timeframe so the bot NEVER chases a pump — it only buys pullbacks
# in an uptrend. Tunable via env:
#   REL_VOLUME_MIN              — below this relative volume = "volume dried up"
#   MAX_RSI_ENTRY               — above this RSI = overbought, no entry
#   MAX_24H_PUMP_PCT            — above this 24h pump % = chasing a spike
#   MAX_EMA200_EXTENSION_PCT    — above this % above EMA200 = overextended
#   MIN_TREND_ALIGNMENT         — require this trend alignment (BULLISH)
#   MAX_PRICE_POSITION_IN_RANGE_PCT — reject if price is in the top N% of
#                            the 20-candle range (default 85 = top 15%)
#   MAX_PRICE_VS_24H_HIGH_PCT   — reject if price is above N% of 24h high
#                            (default 97 = within 3% of the high)
REL_VOLUME_MIN=0.8
MAX_RSI_ENTRY=65.0
MAX_24H_PUMP_PCT=6.0
MAX_EMA200_EXTENSION_PCT=20.0
MIN_TREND_ALIGNMENT=BULLISH
MAX_PRICE_POSITION_IN_RANGE_PCT=85.0
MAX_PRICE_VS_24H_HIGH_PCT=97.0

# =============================================================================
#  Risk Manager
# =============================================================================
MIN_RR=3.0
MAX_RR=6.0
MIN_PROBABILITY=55.0
MAX_ATR_PCT=4.0
MIN_VOLUME_24H=300000000
STOP_ATR_MULTIPLIER=1.5
STOP_FIXED_PCT=2.0
# MIN_STOP_PCT: stops closer than this (% of entry) are widened to this
# floor — a 0.34 % ATR stop on 15m is pure noise and its TP levels sit
# below the round-trip fee cost.
MIN_STOP_PCT=1.5
# MIN_TP1_PCT: TP1 is raised to at least this % above entry so the
# first take-profit clears fees (Indodax taker 0.3 % x2 + slippage).
MIN_TP1_PCT=1.5
MAX_POSITION_SIZE_PCT=0.6

# =============================================================================
#  Position Manager (trailing stop / partial take-profit)
# =============================================================================
TRAIL_ATR_MULTIPLIER=2.0
# Breakeven: move stop to entry once price is +N× ATR in profit (default 1.0)
BREAKEVEN_ATR_MULTIPLIER=1.0
MAX_HOLDING_CANDLES=48
# TP_MULTIPLIERS: TP levels as multiples of stop distance (2.0/4.0/6.0 →
# TP1 at 2× stop distance, TP2 at 4×, TP3 at 6×)
TP_MULTIPLIERS=2.0,4.0,6.0
# TP1_SELL_PCT + TP2_SELL_PCT + TP3_SELL_PCT must sum to 100
# Higher TP1_SELL_PCT = bigger profit on first take-profit, but less
# remaining position to ride to TP2/TP3.
TP1_SELL_PCT=50.0
TP2_SELL_PCT=30.0
TP3_SELL_PCT=20.0

# =============================================================================
#  Paper Trading (fees & slippage simulation)
# =============================================================================
TAKER_FEE=0.003
MAKER_FEE=0.003
SLIPPAGE_BPS=3

# =============================================================================
#  Safety Limits
# =============================================================================
MAX_DAILY_LOSS_PCT=3.0
MAX_CONSECUTIVE_LOSSES=3
MAX_DAILY_TRADES=20
EXCHANGE_FAILURE_WINDOW_SECONDS=300
EXCHANGE_MAX_FAILURES=3
ATR_SPIKE_MULTIPLIER=3.0

# =============================================================================
#  Pipeline Scheduler
# =============================================================================
AUTO_PIPELINE=true
PIPELINE_INTERVAL=120

# =============================================================================
#  Position monitoring cadence (LIVE)
# =============================================================================
# Indodax has NO native stop orders — the SL is executed as a market sell
# at the first poll that sees price <= SL. A 60s poll let a fast 15m move
# run 4-6% past the stop (ACE/IDR: SL 2939 exited at 2800). Poll every
# MONITOR_INTERVAL_SECONDS (default 10s) and keep the shared ticker cache
# TTL (TICKER_TTL_SECONDS, default 10s) short enough to see fresh prices.
MONITOR_INTERVAL_SECONDS=3
TICKER_TTL_SECONDS=3